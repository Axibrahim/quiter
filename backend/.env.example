# Copy to .env and fill with real secrets. NEVER commit the real .env file.

QUITER_ENV=production

# 32+ random bytes, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
FLASK_SECRET_KEY=

# HMAC pepper applied to every password before Argon2id hashing. A SEPARATE
# secret from FLASK_SECRET_KEY — rotating one should never force-invalidate
# the other.
PASSWORD_PEPPER=

DATABASE_URL=postgresql://quiter_app:CHANGE_ME@localhost:5432/quiter

# Shared rate-limit + realtime pub/sub store. Required in any multi-worker
# production deployment — see security/limiter.py.
REDIS_URL=redis://localhost:6379/0
